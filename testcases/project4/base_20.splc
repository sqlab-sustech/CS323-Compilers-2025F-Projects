int im_a_function(int a, int b) {
    return a + b;
}

int im_a_variable;

int main0() {
    int array[10][20];

    im_a_variable();            // identifierNotFunction
    im_a_function = 114514;     // identifierNotVariable

    array[1] = 123;             // unmatchedTypeForBinaryOP
    +array[1];                  // unexpectedType

    int a = array == array[123];    // unmatchedTypeForBinaryOP
    array[1][2] + 1 = 10;       //  lvalueRequired

    im_a_function(1, 2, 3)  // badParamCount, requires 2, given 3.
    im_a_function(array[1][3], array);  // badParamType: 2-th

    return array;               // unexpectedType

}